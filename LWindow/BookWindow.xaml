<Window x:Class="CommunityBookLovers.BookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityBookLovers"
        mc:Ignorable="d"
        Title="Доступные книги" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FF2E1B2A">
    <!-- Темно-бордовый фон -->

    <Window.Resources>
        <!-- Стиль для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF8B5F65"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FF8B5F65"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF8B5F65" Opacity="0.5" BlurRadius="10" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Верхняя панель с меню -->
        <DockPanel LastChildFill="False">
            <Menu DockPanel.Dock="Top" Background="#FF8B5F65" Foreground="White">
                <MenuItem Header="О себе" FontFamily="Segoe Print" Click="MenuItem_AboutMe_Click" Width="57" />
                <MenuItem Header="Своя полка" FontFamily="Segoe Print" Click="MenuItem_MyShelf_Click" />
                <MenuItem Header="Книги" FontFamily="Segoe Print" Click="MenuItem_Books_Click" />
                <MenuItem Header="Друзья" FontFamily="Segoe Print" Click="MenuItem_Friends_Click" />
                <MenuItem Header="Отзывы" FontFamily="Segoe Print" Click="MenuItem_Review_Click" />
                <MenuItem Header="Главная" Click="MenuItem_Home_Click" FontFamily="Segoe UI" FontWeight="Bold"/>
            </Menu>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <Button Content="Выйти" Width="100" Height="30" Click="LogoutButton_Click"/>
                <Button Content="Добавить книгу" Width="120" Height="30" Margin="10,0,0,0" Click="AddBookButton_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Основной контент -->
        <Grid Margin="20,70,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Список книг -->
            <Border Grid.Column="0" Background="#FFF5F5F5" CornerRadius="10" Padding="10">
                <ListBox Name="lstBooks" SelectionChanged="LstBooks_SelectionChanged" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF5F5F5" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel Orientation="Vertical">
                                    <Image x:Name="imgBookCover" 
                                                       MaxHeight="200" 
                                                       MaxWidth="200" 
                                                       Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="5" Foreground="#FF8B5F65"/>
                                    <TextBlock Text="{Binding Author.Name}" FontSize="14" Margin="5" Foreground="#FF8B5F65"/>
                                    <TextBlock Text="{Binding State, FallbackValue='Без статуса'}" FontSize="14" Foreground="Gray" Margin="5"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Детали книги -->
            <Border Grid.Column="1" Background="#FFF5F5F5" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <Image x:Name="imgBookCover" MaxHeight="200" MaxWidth="200" Stretch="Uniform"/>
                    <TextBlock x:Name="txtBookTitle" FontSize="28" FontWeight="Bold" Margin="0,0,0,10" Foreground="#FF8B5F65"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Автор: " FontWeight="Bold" Foreground="#FF8B5F65"/>
                        <TextBlock x:Name="txtBookAuthor" Foreground="#FF8B5F65"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Жанр: " FontWeight="Bold" Foreground="#FF8B5F65"/>
                        <TextBlock x:Name="txtBookGenre" Foreground="#FF8B5F65"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Описание: " FontWeight="Bold" Foreground="#FF8B5F65"/>
                        <TextBlock x:Name="txtBookDescription" TextWrapping="Wrap" Margin="5,0,0,0" FontFamily="Georgia" FontStyle="Italic" FontSize="16" Foreground="#FF8B5F65"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="Статус: " FontWeight="Bold" Margin="0,0,5,0" Foreground="#FF8B5F65"/>
                        <ComboBox x:Name="cbBookStatus" Width="150" Margin="0,0,10,0" Background="#FFF5F5F5" Foreground="#FF8B5F65">
                            <ComboBoxItem Content="Прочитал" />
                            <ComboBoxItem Content="Читаю" />
                            <ComboBoxItem Content="Хочу прочитать" />
                        </ComboBox>
                        <Button Content="Сохранить статус" Click="SaveStatusButton_Click"/>
                        <Button Content="Просмотреть отзывы" Click="ViewingReviewsButton_Click" Width="150" Margin="10,0,0,0"/>
                        <Button Content="Читать" Click="ReadBookButton_Click" 
        Margin="10,0,0,0" Padding="10,2" Width="130" Height="27"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>