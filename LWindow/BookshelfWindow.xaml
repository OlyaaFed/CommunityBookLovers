<Window x:Class="CommunityBookLovers.BookshelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
        mc:Ignorable="d"
        Title="Моя книжная полка" 
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Нежно-бордовый градиентный фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF5F5F5" Offset="0"/>
                <GradientStop Color="#FFD8A7A7" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Верхнее меню -->
        <DockPanel LastChildFill="False">
            <Menu DockPanel.Dock="Top" Background="#FF8B5F65" Foreground="White">
                <MenuItem Header="О себе" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_AboutMe_Click"/>
                <MenuItem Header="Своя полка" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_MyShelf_Click"/>
                <MenuItem Header="Книги" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_Books_Click"/>
                <MenuItem Header="Друзья" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_Friends_Click"/>
                <MenuItem Header="Отзывы" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_Review_Click"/>
                <MenuItem Header="Главная" Click="MenuItem_Home_Click" FontFamily="Segoe UI" FontWeight="Bold"/>
                <MenuItem HorizontalAlignment="Right">
                    <MenuItem.Header>
                        <Button Content="Выйти" Width="80" Height="30" Click="LogoutButton_Click"
                                BorderBrush="#FF8B5F65" Background="#FFA87C7C" Foreground="White"
                                FontWeight="Bold" Cursor="Hand"/>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Основной контент -->
        <Grid Margin="10,50,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель управления -->
            <Border Grid.Column="0" Background="#FFF5F5F5" CornerRadius="10" 
                    BorderBrush="#FF8B5F65" BorderThickness="1" Padding="10">
                <StackPanel>
                    <Button Content="Удалить книгу" Height="35" Margin="0,0,0,15"
                            Click="DeleteBookButton_Click" 
                            Background="#FFA87C7C" Foreground="White"
                            FontWeight="Bold" BorderThickness="0"/>

                    <TextBlock Text="Фильтр по статусу:" FontWeight="Bold" 
                               Foreground="#FF8B5F65" Margin="0,0,0,5"/>

                    <ComboBox x:Name="StatusSortComboBox" Background="White" 
                              BorderBrush="#FF8B5F65" Foreground="#FF8B5F65"
                              SelectionChanged="StatusSortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Все книги" IsSelected="True"/>
                        <ComboBoxItem Content="Прочитал"/>
                        <ComboBoxItem Content="Читаю"/>
                        <ComboBoxItem Content="Хочу прочитать"/>
                    </ComboBox>

                    <Image Stretch="Uniform" Width="150" Height="150" Margin="0,20,0,0">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/photo/rizli.jpg"/>
                        </Image.Source>
                    </Image>
                </StackPanel>
            </Border>

            <!-- Правая панель - список книг -->
            <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="lstBookshelf" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="280" Margin="10" Background="White"
                                    BorderBrush="#FF8B5F65" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Обложка книги -->
                                    <Border Grid.Row="0" Background="#FFF5F5F5" CornerRadius="5 5 0 0">
                                        <Image Source="{Binding Book.ImagePath}" Stretch="Uniform" MaxHeight="160"/>
                                    </Border>

                                    <!-- Информация о книге -->
                                    <StackPanel Grid.Row="1" Margin="10">
                                        <TextBlock Text="{Binding Book.Title}" FontWeight="Bold" 
                                                   Foreground="#FF8B5F65" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Book.Author.Name}" FontStyle="Italic"
                                                   Foreground="#FF8B5F65" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding State}" Foreground="#FF8B5F65" 
                                                   FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>