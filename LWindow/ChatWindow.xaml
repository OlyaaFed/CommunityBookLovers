<Window x:Class="CommunityBookLovers.LWindow.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Height="500" Width="400" 
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Чат с пользователем" 
                  Background="#FF8B5F65" Foreground="White"
                  Padding="10" FontWeight="Bold"/>

        <!-- Сообщения -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MessagesPanel" Margin="10"/>
        </ScrollViewer>

        <!-- Ввод сообщения -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
            <TextBox x:Name="MessageBox" Width="300" Padding="5" 
                    KeyDown="MessageBox_KeyDown"/>
            <Button Content="Отправить" Margin="5,0,0,0" 
                    Click="SendButton_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>