<Window x:Class="CommunityBookLovers.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Регистрация" 
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid Margin="0,0,0,-44">
        <!-- Градиентный фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF5F5F5" Offset="0"/>
                <GradientStop Color="#FFD8A7A7" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Основной контент -->
        <Border CornerRadius="10" Background="White" 
                BorderBrush="#FF8B5F65" BorderThickness="1"
                Width="500" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="30">
            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Регистрация" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="#FF8B5F65"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Поля ввода -->
                <StackPanel Margin="0,10">
                    <Label Content="Имя*" Foreground="#FF8B5F65" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtName" Height="35" Padding="5"
                             BorderBrush="#FF8B5F65" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Margin="0,10">
                    <Label Content="Email*" Foreground="#FF8B5F65" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtEmail" Height="35" Padding="5"
                             BorderBrush="#FF8B5F65" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Margin="0,10">
                    <Label Content="Пароль*" Foreground="#FF8B5F65" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="txtPassword" Height="35" Padding="5"
                                 BorderBrush="#FF8B5F65" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Margin="0,10">
                    <Label Content="Повторите пароль*" Foreground="#FF8B5F65" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="txtConfirmPassword" Height="35" Padding="5"
                                 BorderBrush="#FF8B5F65" BorderThickness="1"/>
                </StackPanel>

                <!-- Кнопка регистрации -->
                <Button x:Name="btnRegister" Content="Зарегистрироваться" 
                        Click="btnRegister_Click"
                        Background="#FF8B5F65" Foreground="White"
                        FontWeight="Bold" Height="40" Margin="0,20"
                        BorderThickness="0"/>

                <!-- Ссылка на вход -->
                <TextBlock HorizontalAlignment="Center" Margin="0,10">
                    <Run Text="Уже есть аккаунт? "/>
                    <Hyperlink Click="Hyperlink_Click" Foreground="#FF8B5F65">
                        Войти
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>