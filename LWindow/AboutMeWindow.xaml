<Window x:Class="CommunityBookLovers.AboutMeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:CommunityBookLovers"
        mc:Ignorable="d"
        Title="Личный профиль читателя" Height="650" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Нежно-бордовый градиентный фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF5F5F5" Offset="0"/>
                <!-- Белый -->
                <GradientStop Color="#FFD8A7A7" Offset="1"/>
                <!-- Нежно-бордовый -->
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Верхняя панель с меню и кнопкой "Выйти" -->
        <DockPanel LastChildFill="False">
            <Menu DockPanel.Dock="Top" Background="#FF8B5F65" Foreground="White">
                <MenuItem Header="О себе" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_AboutMe_Click"/>
                <MenuItem Header="Своя полка" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_MyShelf_Click"/>
                <MenuItem Header="Книги" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_Books_Click"/>
                <MenuItem Header="Друзья" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_Friends_Click"/>
                <MenuItem Header="Отзывы" FontFamily="Segoe UI" FontWeight="Bold" Click="MenuItem_Review_Click"/>
                <MenuItem Header="Главная" Click="MenuItem_Home_Click" FontFamily="Segoe UI" FontWeight="Bold"/>
                <!-- Кнопка "Выйти" внутри Menu -->
                <MenuItem HorizontalAlignment="Right">
                    <MenuItem.Header>
                        <Button Content="Выйти" Width="80" Height="30" Click="LogoutButton_Click"
                        BorderBrush="#FF8B5F65" Background="#FFA87C7C" Foreground="White"
                        FontWeight="Bold" Cursor="Hand"/>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Левая панель с фото профиля, именем, почтой и кнопкой "Редактировать" -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="20,50,0,0" Width="250">
        <!-- Фото профиля -->
        <Border BorderThickness="2" BorderBrush="#FF8B5F65" CornerRadius="10" Background="#FFF5F5F5" Padding="5" Height="160" Width="240">
            <Image x:Name="ProfileImage" Width="150" Height="150" Margin="5"/>
        </Border>

        <!-- Кнопка для загрузки фото (видна только в режиме редактирования) -->
        <Button x:Name="btnUploadImage" Content="Загрузить фото" Width="150"
            Click="btnUploadImage_Click" Background="#FF8B5F65" Foreground="#FFF5F5F5"
            FontWeight="Bold" Cursor="Hand" Margin="0,10,0,0" Visibility="Collapsed"/>

        <!-- Имя и почта -->
        <TextBlock Text="Имя:" FontSize="14" FontWeight="Bold" Foreground="#FF8B5F65"
               Margin="0,10,0,5"/>
        <TextBox x:Name="txtName" Width="200" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#FF8B5F65"
             Background="#FFF5F5F5" Foreground="#FF8B5F65" FontSize="14" IsReadOnly="True"/>

        <TextBlock Text="Email:" FontSize="14" FontWeight="Bold" Foreground="#FF8B5F65"
               Margin="0,0,0,5"/>
        <TextBox x:Name="txtEmail" Width="200" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#FF8B5F65"
             Background="#FFF5F5F5" Foreground="#FF8B5F65" FontSize="14" IsReadOnly="True"/>

        <!-- Кнопка "Редактировать" -->
        <Button x:Name="btnEdit" Content="Редактировать" Width="120" Margin="0,10,0,0"
            Click="btnEdit_Click" Background="#FF8B5F65" Foreground="#FFF5F5F5"
            FontWeight="Bold" Cursor="Hand"/>
        <Button x:Name="btnSave" Content="Сохранить" Width="120" Margin="0,5,0,0"
            Click="btnSave_Click" Visibility="Collapsed"
            Background="#FF8B5F65" Foreground="#FFF5F5F5"
            FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>

        <!-- Панель с прочитанными книгами -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="10" Height="200" Width="600" Background="#FFF5F5F5" Opacity="0.95"
                    >
            <TextBlock Text="Последние прочитанные книги:" FontSize="16" FontWeight="Bold"
                       Foreground="#FF8B5F65" Margin="10,5,5,5"/>
            <ItemsControl x:Name="RecentBooksList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF5F5F5" Padding="10" Margin="5" BorderBrush="#FF8B5F65"
                                BorderThickness="1" CornerRadius="5">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Image Source="{Binding ImagePath}" Width="50" Height="75" Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding Title}" Foreground="#FF8B5F65" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>