<Window x:Class="CommunityBookLovers.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавление новой книги" 
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка с заголовком -->
        <Border Grid.Row="0" Background="#FF8B5F65" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Добавление новой книги" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть - форма ввода -->
                <StackPanel Grid.Column="0" Width="350" Margin="0,0,20,0">
                    <!-- Название -->
                    <Label Content="Название книги*:" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <TextBox x:Name="TitleTextBox" Margin="0,0,0,10" Height="30"/>

                    <!-- Автор -->
                    <Label Content="Автор*:" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <ComboBox x:Name="AuthorComboBox" Margin="0,0,0,10" Height="30"
                              ItemsSource="{Binding Authors}" 
                              SelectedValuePath="AuthorId" 
                              DisplayMemberPath="Name"/>

                    <!-- Жанр -->
                    <Label Content="Жанр*:" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <ComboBox x:Name="GenreComboBox" Margin="0,0,0,10" Height="30"
                              ItemsSource="{Binding Genres}" 
                              SelectedValuePath="GenreId" 
                              DisplayMemberPath="Name"/>

                    <!-- Год издания -->
                    <Label Content="Год издания:" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <TextBox x:Name="PublicationYearTextBox" Margin="0,0,0,10" Height="30"/>

                    <!-- Страницы -->
                    <Label Content="Количество страниц:" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <TextBox x:Name="PagesTextBox" Margin="0,0,0,10" Height="30"/>

                    <!-- Статус -->
                    <Label Content="Статус по умолчанию:" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <ComboBox x:Name="StateComboBox" Margin="0,0,0,10" Height="30"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Без статуса"/>
                        <ComboBoxItem Content="Хочу прочитать"/>
                        <ComboBoxItem Content="Читаю"/>
                        <ComboBoxItem Content="Прочитал"/>
                    </ComboBox>
                </StackPanel>

                <!-- Центральная часть - описание -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <Label Content="Описание:" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <TextBox x:Name="DescriptionTextBox" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="150"/>
                </StackPanel>

                <!-- Правая часть - обложка и файл книги -->
                <StackPanel Grid.Column="2">
                    <!-- Обложка -->
                    <Label Content="Обложка книги:" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <Border BorderBrush="#FF8B5F65" BorderThickness="1" CornerRadius="5"
                            Width="200" Height="250" Margin="0,0,0,10">
                        <Image x:Name="CoverImage" Stretch="Uniform" Source="/photo/defaultbook.png"/>
                    </Border>
                    <Button Content="Выбрать обложку" Margin="0,0,0,20"
                            Click="SelectImageButton_Click"
                            Background="#FF8B5F65" Foreground="White"/>

                    <!-- Файл книги -->
                    <Label Content="Файл книги (PDF, EPUB, FB2):" Foreground="#FF8B5F65" FontWeight="Bold"/>
                    <TextBlock x:Name="BookFilePathText" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <Button Content="Выбрать файл книги" 
                            Click="SelectBookFileButton_Click"
                            Background="#FF8B5F65" Foreground="White"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Нижняя панель с кнопками -->
        <Border Grid.Row="2" Background="#FFE0E0E0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назад" Width="120" Margin="0,0,10,0"
                        Click="BackButton_Click"
                        Background="#FFA87C7C" Foreground="White"
                        FontWeight="Bold"/>
                <Button x:Name="SaveButton" Content="Сохранить книгу" Width="150"
                        Click="SaveButton_Click"
                        Background="#FF8B5F65" Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>