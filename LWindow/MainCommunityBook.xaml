<Window x:Class="CommunityBookLovers.MainCommunityBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityBookLovers"
        mc:Ignorable="d"
        Title="Главная страница" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#FFF5F5F5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#FF8B5F65"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HeaderTextStyle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF8B5F65"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Геометрический фон с ромбиками -->
        <Grid.Background>
            <VisualBrush TileMode="Tile" Viewport="0,0,100,100" ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Grid Width="100" Height="100">
                        <Rectangle Fill="#FFF5F5F5"/>
                        <Path Data="M50,0 L100,50 L50,100 L0,50 Z" 
                              Fill="#FF8B5F65" Opacity="0.05"/>
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

        <!-- Главный контейнер -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхнее меню -->
            <Menu Grid.Row="0" Background="#FF8B5F65" Foreground="White" FontSize="16">
                <MenuItem Header="Главная" Click="MenuItem_Home_Click"/>
                <MenuItem Header="Книги" Click="MenuItem_Books_Click"/>
                <MenuItem Header="Авторы">
                    
                </MenuItem>
                <MenuItem Header="Моя полка" Click="MenuItem_MyShelf_Click"/>
                <MenuItem Header="Сообщество" Click="MenuItem_Friends_Click"/>
                <MenuItem Header="Отзывы" Click="MenuItem_Review_Click"/>
                <MenuItem Header="Обо мне" Click="MenuItem_AboutMe_Click"/>
            </Menu>

            <!-- Основное содержимое -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левый блок (основной контент) -->
                    <StackPanel Grid.Column="0">
                        <!-- Приветствие -->
                        <Border Style="{StaticResource CardStyle}" Background="#FF8B5F65">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/photo/tartagliya.png" 
                                       Width="75" Height="69" Margin="0,0,15,0"/>
                                <TextBlock Name="WelcomeText" FontSize="28" FontWeight="Bold" 
                                           Foreground="White" TextAlignment="Center">
                                    <Run Text="Добро пожаловать, "/>
                                    <Run x:Name="UserNameRun" FontWeight="ExtraBold" 
                                         TextDecorations="Underline"/>
                                    <Run Text="!"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Статистика -->
                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <!-- Книги -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Книги на полке" FontSize="16" 
                                               Foreground="#FF8B5F65" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BooksCount" FontSize="36" FontWeight="Bold" 
                                               Foreground="#FF8B5F65" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Друзья -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Друзей" FontSize="16" 
                                               Foreground="#FF8B5F65" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="FriendsCount" FontSize="36" FontWeight="Bold" 
                                               Foreground="#FF8B5F65" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Отзывы -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Оставлено отзывов" FontSize="16" 
                                               Foreground="#FF8B5F65" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ReviewsCount" FontSize="36" FontWeight="Bold" 
                                               Foreground="#FF8B5F65" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Рекомендуемые книги -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Рекомендуемые книги:" Style="{StaticResource HeaderTextStyle}"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                              VerticalScrollBarVisibility="Disabled" Height="280">
                                    <ItemsControl x:Name="RecommendedBooks">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="180" Height="250" Margin="10" Background="White"
                                                        BorderBrush="#FF8B5F65" BorderThickness="1" CornerRadius="5">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Обложка книги -->
                                                        <Border Grid.Row="0" Background="#FFF5F5F5" CornerRadius="5,5,0,0">
                                                            <Image Source="{Binding ImagePath}" Stretch="Uniform" MaxHeight="150"/>
                                                        </Border>

                                                        <!-- Информация о книге -->
                                                        <StackPanel Grid.Row="1" Margin="10">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" 
                                                                       Foreground="#FF8B5F65" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Author.Name}" FontStyle="Italic"
                                                                       Foreground="#FF8B5F65" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Правый блок (авторы) -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,50,10,10">
                        <StackPanel>
                            <TextBlock Text="Популярные авторы:" Style="{StaticResource HeaderTextStyle}"/>
                            <ListView x:Name="PopularAuthorsList" Margin="0,10,0,0" 
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,5" Padding="10" Background="White" 
                                                CornerRadius="5" BorderBrush="#FF8B5F65" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" 
                                                               Foreground="#FF8B5F65"/>
                                                    <TextBlock Text="{Binding Books.Count, StringFormat='{}Книг: {0}'}" 
                                                               FontSize="12" Foreground="#FF8B5F65" Opacity="0.7"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>