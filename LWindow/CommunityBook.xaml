<Window x:Class="CommunityBookLovers.LWindow.CommunityBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityBookLovers.LWindow"
        mc:Ignorable="d"
        Title="Друзья" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FF2D2D30"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Общие стили (как в BookWindow) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF8B5F65"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FF8B5F65"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF8B5F65" Opacity="0.5" BlurRadius="10" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для списков -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FFF5F5F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Стиль для элементов списка друзей -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="#FFF5F5F5" CornerRadius="5" Padding="10">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Верхняя панель (как в BookWindow) -->
        <DockPanel LastChildFill="False">
            <Menu DockPanel.Dock="Top" Background="#FF8B5F65" Foreground="White">
                <MenuItem Header="О себе" FontFamily="Segoe Print" Click="MenuItem_AboutMe_Click" Width="57"/>
                <MenuItem Header="Своя полка" FontFamily="Segoe Print" Click="MenuItem_MyShelf_Click"/>
                <MenuItem Header="Книги" FontFamily="Segoe Print" Click="MenuItem_Books_Click"/>
                <MenuItem Header="Друзья" FontFamily="Segoe Print" Click="MenuItem_Friends_Click"/>
                <MenuItem Header="Отзывы" FontFamily="Segoe Print" Click="MenuItem_Review_Click"/>
                <MenuItem Header="Главная" Click="MenuItem_Home_Click" FontFamily="Segoe UI" FontWeight="Bold"/>
            </Menu>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <Button Content="Выйти" Width="100" Height="30" Click="LogoutButton_Click"/>
                <Button Content="Добавить друга" Width="120" Height="30" Margin="10,0,0,0" Click="AddFriendButton_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Основной контент -->
        <Grid Margin="20,70,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - списки -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок заявок -->
                <TextBlock Text="Заявки в друзья" FontSize="18" FontWeight="Bold" 
                          Foreground="#FF8B5F65" Margin="5,0,5,10"/>

                <!-- Список заявок -->
                <Border Grid.Row="1" Background="#FFF5F5F5" CornerRadius="10" Padding="5">
                    <ListBox x:Name="lstFriendRequests">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding SenderName}" FontWeight="Bold" 
                                              FontSize="16" Foreground="#FF8B5F65"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                        <Button Content="Принять" Width="80" Margin="0,0,5,0" 
                                               Tag="{Binding RequestId}" Click="AcceptRequest_Click"/>
                                        <Button Content="Отклонить" Width="80" 
                                               Tag="{Binding RequestId}" Click="RejectRequest_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Заголовок поиска -->
                <TextBlock Grid.Row="2" Text="Поиск друзей" FontSize="18" FontWeight="Bold" 
                          Foreground="#FF8B5F65" Margin="5,20,5,10"/>

                <!-- Панель поиска -->
                <Border Grid.Row="3" Background="#FFF5F5F5" CornerRadius="10" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="txtSearch" Width="200" Margin="0,0,10,0"/>
                            <Button Content="Найти" Click="SearchButton_Click"/>
                        </StackPanel>
                        <ListBox x:Name="lstSearchResults" Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Width="150" 
                                                  VerticalAlignment="Center" Foreground="#FF8B5F65"/>
                                        <Button Content="Добавить" Margin="10,0,0,0" 
                                               Tag="{Binding UserId}" Click="SendRequest_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Правая панель - список друзей -->
            <Border Grid.Column="1" Background="#FFF5F5F5" CornerRadius="10" Padding="10" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Мои друзья" FontSize="20" FontWeight="Bold" 
                              Foreground="#FF8B5F65" Margin="0,0,0,10"/>

                    <ListBox x:Name="lstFriends" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}" FontSize="16" 
                                                  FontWeight="Bold" Foreground="#FF8B5F65"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Чат" Width="80" Margin="0,0,10,0" 
                                                   Tag="{Binding UserId}" Click="StartChat_Click"/>
                                            <Button Content="Удалить" Width="80" 
                                                   Tag="{Binding UserId}" Click="RemoveFriend_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>